{
  "name": "stat-window",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stat Window: a daily sports estimation game.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && npm run api:build && npm run api:check && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "content:check": "node --experimental-strip-types scripts/content-check.ts && npm run categories:check",
    "content:trivia:check": "node --experimental-strip-types scripts/trivia-audit.ts",
    "content:trivia:complete": "node --experimental-strip-types scripts/trivia-audit.ts --require-complete",
    "remind:ics": "node --experimental-strip-types scripts/remind-ics.ts",
    "content:new": "node --experimental-strip-types scripts/content-new.ts",
    "nba:db": "node --experimental-strip-types scripts/nba/db.ts",
    "nba:report": "node --experimental-strip-types scripts/nba/report.ts",
    "nba:report:check": "node --experimental-strip-types scripts/nba/report.ts --check",
    "content:publish": "node --experimental-strip-types scripts/nba/publish.ts",
    "content:publish:check": "node --experimental-strip-types scripts/nba/publish.ts --check",
    "content:lock": "node --experimental-strip-types scripts/content-lock.ts",
    "nba:reschedule": "node --experimental-strip-types scripts/nba/reschedule.ts",
    "survival:catalog": "node --experimental-strip-types scripts/nba/survival.ts",
    "survival:catalog:check": "node --experimental-strip-types scripts/nba/survival.ts --check",
    "survival:sim": "node --experimental-strip-types scripts/survival-sim.ts",
    "test:e2e:survival": "SURVIVAL_E2E=1 playwright test e2e/survival.spec.ts",
    "test:e2e:analytics": "ANALYTICS_E2E=1 playwright test e2e/analytics.spec.ts",
    "factory": "node --experimental-strip-types scripts/question-factory/cli.ts",
    "factory:check": "node --experimental-strip-types scripts/question-factory/cli.ts check",
    "api:build": "vite build --config vite.api.config.ts --logLevel warn && vite build --config vite.leaderboard.config.ts --logLevel warn",
    "api:check": "node --experimental-strip-types scripts/api-check.ts",
    "categories:check": "node --experimental-strip-types scripts/nba/category-labels.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@vercel/analytics": "2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
